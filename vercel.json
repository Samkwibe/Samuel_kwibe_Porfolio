{
  "buildCommand": "VERCEL=1 npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm ci",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/Samuel_kwibe_Porfolio/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/Samuel_kwibe_Porfolio/repo_images_bundle/(.*)",
      "destination": "/repo_images_bundle/$1"
    },
    {
      "source": "/Samuel_kwibe_Porfolio/api/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}


